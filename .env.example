# -------------------------------------------------------------
# FitSync 环境变量配置说明 (Garmin CN -> Global 同步)
# -------------------------------------------------------------

# 1. 佳明中国区账号 (garmin.cn)
GARMIN_CN_USERNAME=your_cn_email@example.com
GARMIN_CN_PASSWORD=your_cn_password

# 2. 佳明国际区账号 (garmin.com)
GARMIN_GLOBAL_USERNAME=your_global_email@example.com
GARMIN_GLOBAL_PASSWORD=your_global_password

# 3. Upstash Redis / Vercel KV (用于在 Vercel Serverless 上持久化同步状态与 OAuth 会话)
# 在 Vercel 控制台一键添加 "Upstash Redis" 或 "Vercel KV" 存储即可自动注入以下变量：
KV_REST_API_URL=https://xxxx.upstash.io
KV_REST_API_TOKEN=xxxx

# 4. Vercel 定时任务密钥 (可选，用于安全保护 /api/cron 触发端点)
CRON_SECRET=your_random_secret_token

# 5. 管理员访问保护 (可选)
FITSYNC_ADMIN_PASSWORD=
